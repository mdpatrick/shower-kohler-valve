# Evidence and selected snapshots are real ordinary Git blobs, never LFS pointers.
data/raw/polycam/*.zip -filter -diff -merge -text
deliverables/**/*.blend -filter -diff -merge -text
deliverables/**/*.glb -filter -diff -merge -text
deliverables/**/*.pdf -filter -diff -merge -text

# Preserve downloaded evidence and neutral CAD exports byte-for-byte, including source line endings.
data/evidence/** -text -diff -merge -filter
deliverables/current/cad/*.step -text -diff -merge -filter
deliverables/current/cad/*.dxf -text -diff -merge -filter
